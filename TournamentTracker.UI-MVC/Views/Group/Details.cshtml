@model Group

@{
    ViewData["Title"] = "Group Details";
}

<a class="back-link" asp-controller="Championship" asp-action="Index">← Championships</a>
<div class="page-intro"><div><span class="eyebrow">THE GROUP STAGE</span><h1>Group @Model.GroupCode</h1><p class="page-description">@Model.Championship.HostCountry · @Model.Championship.ChampionshipEdition.ToString("yyyy")</p></div><span class="pill">Up to @Model.MaxTeams teams</span></div>

<section class="detail-summary">
    <div class="mb-3 row">
        <span class="col-sm-2 fw-bold">Group code</span>
        <span class="col-sm-10">@Model.GroupCode</span>
    </div>
    <div class="mb-3 row">
        <span class="col-sm-2 fw-bold">Maximum teams</span>
        <span class="col-sm-10">@Model.MaxTeams</span>
    </div>
    <div class="mb-3 row">
        <span class="col-sm-2 fw-bold">Championship</span>
        <span class="col-sm-10">@Model.Championship.HostCountry @Model.Championship.ChampionshipEdition.ToString("yyyy")</span>
    </div>
</section>

<h2>Teams in this group</h2>

<div class="data-panel table-responsive mb-4">
<table class="table table-striped" id="groupTeamsTable">
    <thead>
    <tr>
        <th>Name</th>
        <th>Country</th>
        <th>Points</th>
    </tr>
    </thead>
    <tbody></tbody>
</table>
</div>

<h3>Add team to group</h3>

<form class="editor-panel group-editor">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="teamSelect">Team</label>
            <select class="form-select" id="teamSelect"></select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="pointsInput">Points</label>
            <input class="form-control" id="pointsInput" type="number" value="0" min="0" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-primary w-100" id="addBtn">Add</button>
        </div>
    </div>
</form>

<div class="text-danger mt-2" id="errorBox"></div>

<div id="groupMeta" data-group-id="@Model.Id"></div>

@section Scripts
{
    <script src="~/js/group-details.js"></script>
}
