@{
    ViewData["Title"] = "Championships";
}

<div class="page-intro">
    <div><span class="eyebrow">THE WORLD STAGE</span><h1>Championships.</h1><p class="page-description">Every edition. Every host. Explore the competitions.</p></div>
    <button id="reloadBtn" class="btn btn-outline-secondary">Refresh list <span aria-hidden="true">↻</span></button>
</div>

<div class="data-panel">
<div class="panel-heading"><h2>All championships</h2><span class="pill">Competition directory</span></div>
<div class="table-responsive">

<table class="table table-striped" id="championshipsTable">
    <thead>
    <tr>
        <th>Edition</th>
        <th>Host Country</th>
        <th>Type</th>
        <th>#Groups</th>
    </tr>
    </thead>
    <tbody></tbody>
</table>
</div>
</div>

@section Scripts {
    <script src="~/js/championships.js" asp-append-version="true"></script>
}
