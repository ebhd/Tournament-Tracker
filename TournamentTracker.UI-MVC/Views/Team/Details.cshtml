@model Team

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Team Details";
    var maintainer = Model.MaintainerId == null ? null : await UserManager.FindByIdAsync(Model.MaintainerId);
    var canEditTeamValue = (User.Identity?.IsAuthenticated ?? false) &&
        (User.IsInRole("admin") || Model.MaintainerId == User.FindFirstValue(ClaimTypes.NameIdentifier));
}

<a class="back-link" asp-controller="Team" asp-action="Index">← Back to teams</a>
<div class="page-intro"><div><span class="eyebrow">INSIDE THE TEAM</span><h1>Team details.</h1><p class="page-description">A closer look at the squad and its competitions.</p></div><span class="pill">@Model.Country</span></div>

<div id="teamDetailsRoot" class="card mb-4" data-team-id="@Model.Id">
    <div class="card-body">
        <div class="team-detail-heading"><partial name="_TeamLogo" model="Model" /><h4 class="card-title">@Model.Name (@Model.Country)</h4></div>
        <p><strong>Maintained by</strong> @(maintainer?.UserName ?? "unknown")</p>

        <dl class="row">
            <dt class="col-sm-3">Coach</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Coach) ? "unknown" : Model.Coach)
            </dd>

            <dt class="col-sm-3">Squad value (EUR)</dt>
            <dd class="col-sm-9">
                @(Model.TeamValue.HasValue
                    ? "€" + Model.TeamValue.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))
                    : "unknown")
            </dd>
        </dl>
        @if (canEditTeamValue)
        {
            <form id="teamValueForm">
                @Html.AntiForgeryToken()
                <label for="teamValueInput" class="form-label">Team value (EUR)</label>
                <input id="teamValueInput" class="form-control" type="number" min="0" step="0.01"
                       value="@Model.TeamValue?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                <p class="form-text">Leave empty to clear the team value.</p>
                <button type="submit" class="btn btn-primary">Update</button>
                <p id="teamValueStatus" role="status" class="text-danger"></p>
            </form>
        }
        else
        {
            <p class="text-muted">Only the team maintainer or an admin can update the team value.</p>
        }
    </div>
</div>

<h2>Groups</h2>

@if (Model.Groups == null || !Model.Groups.Any())
{
    <p>This team is not linked to any groups.</p>
}
else
{
    <div class="data-panel table-responsive">
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Group code</th>
            <th>Max teams</th>
            <th>Points</th>
            <th>Championship</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var gt in Model.Groups)
        {
            var g = gt.Group;

            <tr>
                <td>@g.GroupCode</td>
                <td>@g.MaxTeams</td>
                <td>@gt.Points</td>
                <td>
                    @(
                        g.Championship == null
                            ? "unknown"
                            : $"{g.Championship.HostCountry} {g.Championship.ChampionshipEdition:yyyy}"
                      )
                </td>
                <td>
                    <a asp-controller="Group"
                       asp-action="Details"
                       asp-route-id="@g.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<p class="mt-3">
    <a asp-controller="Team" asp-action="Index">Back to list</a>
</p>

@section Scripts
{
    <script src="~/js/team-details.js" asp-append-version="true"></script>
}
