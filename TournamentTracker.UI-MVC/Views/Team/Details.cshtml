@model Team

@{
    ViewData["Title"] = "Team Details";
}

<h1>Team Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4 class="card-title">@Model.Name (@Model.Country)</h4>

        <dl class="row">
            <dt class="col-sm-3">Coach</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Coach) ? "unknown" : Model.Coach)
            </dd>

            <dt class="col-sm-3">Logo URL</dt>
            <dd class="col-sm-9">@Model.LogoImage</dd>

            <dt class="col-sm-3">Team value</dt>
            <dd class="col-sm-9">
                @(Model.TeamValue.HasValue
                    ? Model.TeamValue.Value.ToString("C")
                    : "unknown")
            </dd>
        </dl>
    </div>
</div>

<h2>Groups</h2>

@if (Model.Groups == null || !Model.Groups.Any())
{
    <p>This team is not linked to any groups.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Group code</th>
            <th>Max teams</th>
            <th>Points</th>
            <th>Championship</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var gt in Model.Groups)
        {
            var g = gt.Group;

            <tr>
                <td>@g.GroupCode</td>
                <td>@g.MaxTeams</td>
                <td>@gt.Points</td>
                <td>
                    @(
                        g.Championship == null
                            ? "unknown"
                            : $"{g.Championship.HostCountry} {g.Championship.ChampionshipEdition:yyyy}"
                      )
                </td>
                <td>
                    <a asp-controller="Group"
                       asp-action="Details"
                       asp-route-id="@g.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<p class="mt-3">
    <a asp-controller="Team" asp-action="Index">Back to list</a>
</p>
