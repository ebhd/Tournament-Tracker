@model TeamDetailsViewModel

@{
    ViewData["Title"] = "Team Details";
    var team = Model.Team;
    var teamValueInputValue = team.TeamValue?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}

<h1>Team Details</h1>

<div id="teamDetailsRoot" class="card mb-4" data-team-id="@team.Id">
    <div class="card-body">
        <h4 class="card-title">@team.Name (@team.Country)</h4>

        <p class="text-muted mb-3"><strong>Maintained by</strong> @Model.MaintainerName</p>

        <dl class="row mb-0">
            <dt class="col-sm-3">Coach</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(team.Coach) ? "unknown" : team.Coach)
            </dd>

            <dt class="col-sm-3">Logo URL</dt>
            <dd class="col-sm-9">@team.LogoImage</dd>

            <dt class="col-sm-3">Team value</dt>
            <dd class="col-sm-9">
                <span id="teamValueReadout"
                      data-testid="team-value-readout">
                    @(team.TeamValue.HasValue
                        ? team.TeamValue.Value.ToString("C")
                        : "unknown")
                </span>
            </dd>
        </dl>

        @if (Model.CanEditTeamValue)
        {
            <hr class="my-4" />
            <section aria-labelledby="teamValueEditorHeading" data-testid="team-value-editor">
                <h2 id="teamValueEditorHeading" class="h5">Update TeamValue</h2>
                <p class="text-muted mb-3">
                    You can edit this value because you are @(Model.IsAdmin ? "an admin" : "the team maintainer").
                </p>

                <form id="teamValueForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="teamValueInput">TeamValue</label>
                        <input id="teamValueInput"
                               name="teamValue"
                               type="number"
                               class="form-control"
                               min="0"
                               step="0.01"
                               inputmode="decimal"
                               value="@teamValueInputValue"
                               aria-describedby="teamValueHelp teamValueStatus" />
                        <div id="teamValueHelp" class="form-text">
                            Leave the field empty to clear the TeamValue.
                        </div>
                    </div>
                    <button id="teamValueSubmitButton" type="submit" class="btn btn-primary">Update</button>
                </form>

                <div id="teamValueStatus"
                     class="alert mt-3"
                     role="status"
                     aria-live="polite"
                     hidden></div>
            </section>
        }
        else
        {
            <div class="mt-4" data-testid="team-value-readonly-note">
                <p class="text-muted mb-0">Only the team maintainer or an admin can update the TeamValue.</p>
            </div>
        }
    </div>
</div>

<h2>Groups</h2>

@if (team.Groups == null || !team.Groups.Any())
{
    <p>This team is not linked to any groups.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Group code</th>
            <th>Max teams</th>
            <th>Points</th>
            <th>Championship</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var gt in team.Groups)
        {
            var g = gt.Group;

            <tr>
                <td>@g.GroupCode</td>
                <td>@g.MaxTeams</td>
                <td>@gt.Points</td>
                <td>
                    @(
                        g.Championship == null
                            ? "unknown"
                            : $"{g.Championship.HostCountry} {g.Championship.ChampionshipEdition:yyyy}"
                     )
                </td>
                <td>
                    <a asp-controller="Group"
                       asp-action="Details"
                       asp-route-id="@g.Id">
                        Details
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<p class="mt-3">
    <a asp-controller="Team" asp-action="Index">Back to list</a>
</p>

@section Scripts
{
    <script src="~/js/team-details.js" asp-append-version="true"></script>
}
