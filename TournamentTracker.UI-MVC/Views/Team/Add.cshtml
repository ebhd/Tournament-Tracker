@model NewTeamViewModel

@{
    ViewData["Title"] = "Add Team";
}

<a class="back-link" asp-action="Index">← Back to teams</a>
<div class="page-intro"><div><span class="eyebrow">BUILD YOUR LINEUP</span><h1>Add a team.</h1><p class="page-description">Give your team a place in the competition.</p></div></div>

<form asp-action="Add" method="post" class="editor-panel">
    <h2>Team information</h2>
    <p class="text-muted mb-4">Start with the basics. You can manage the team value from its details page.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Country" class="form-label"></label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Coach" class="form-label"></label>
        <input asp-for="Coach" class="form-control" />
        <span asp-validation-for="Coach" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LogoImage" class="form-label">Logo image URL</label>
        <input asp-for="LogoImage" class="form-control" />
        <span asp-validation-for="LogoImage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TeamValue" class="form-label">Team value (EUR)</label>
        <input asp-for="TeamValue" class="form-control" />
        <span asp-validation-for="TeamValue" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}
